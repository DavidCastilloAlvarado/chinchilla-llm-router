# llm-router environment variables.
#
# Copy this file to `.env` and fill in real values:
#
#	cp .env.example .env
#
# The router loads `.env` from the working directory at startup, BEFORE
# expanding ${VAR} references in the config file. `.env` values take
# priority over system environment variables; when `.env` is absent the
# system environment is used as-is.
#
# `.env` is gitignored — never commit real credentials.

# --- Router client auth (optional) ---------------------------------------
# When set, clients must send "Authorization: Bearer <ROUTER_API_KEY>".
# Empty = auth disabled.
ROUTER_API_KEY=

# --- Upstream credentials -------------------------------------------------
# OpenAI (used by the "openai-main" credential in config.yaml)
OPENAI_API_KEY=

# Azure OpenAI / Azure AI Foundry (used by the "azure-foundry" credential)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Optional: local vLLM / other OpenAI-compatible upstream
# (uncomment the vllm credential block in config.yaml to use)
#VLLM_BASE_URL=http://127.0.0.1:8000/v1
#VLLM_API_KEY=

# --- E2E tests (make e2etest) ----------------------------------------------
# Real upstream the e2e suite probes. Tests skip when the key is unset or
# the upstream is unreachable.
E2E_BASE_URL=http://192.168.18.200:1235/v1
E2E_API_KEY=
E2E_MODEL=qwen3.8-27b
